{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "Node 26",
  "_version": "26.0.0",

  "compilerOptions": {
    "lib": ["es2025", "ESNext.Collection", "ESNext.Temporal"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2025",
    "types": ["node"],

    "esModuleInterop": true,
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
